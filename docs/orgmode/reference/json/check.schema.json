{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackhands.github.io/eb-pipeline/reference/json/check.schema.json",
  "title": "eb-pipeline check --format json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "valid",
    "probe_tools",
    "problems",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "check" },
    "valid": { "type": "boolean" },
    "site": { "type": ["string", "null"] },
    "probe_tools": { "type": "boolean" },
    "problems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      }
    }
  }
}