#!/usr/bin/env bash
# Prepare the tree for a release: the pre-bump hook of cog.toml.
#
# usage: tools/release-prepare NEW_VERSION
#
# `cog bump` runs this with the version it is about to tag, then commits what
# changed and creates the tag. For NEW_VERSION and the version Cargo.toml
# still names (OLD) it sets:
#   - CHANGELOG.md: `towncrier build` writes the fragments of changelog.d/
#     under a heading for NEW_VERSION and removes them; the release workflow
#     takes the release notes from that section;
#   - Cargo.toml and the eb-pipeline entry of Cargo.lock: the version, which
#     the release workflow compares with the tag. Nothing is compiled, and no
#     dependency moves;
#   - share/man/eb-pipeline.1: the two places the generated page prints the
#     version, so the page matches what `eb-pipeline man` writes and CI's
#     comparison passes;
#   - docs/orgmode: the `--version` line and the `tool` field of the example
#     summaries.
#
# Not done here, because it is prose: the paragraph of
# docs/orgmode/howto/install.org that says what the previous release lacks.
# Edit it in a commit before the bump.
#
# Needs: towncrier (or uvx). A refused run can leave
# edited files behind; `git checkout -- .` puts the tree back.
set -euo pipefail

new=${1:?usage: tools/release-prepare NEW_VERSION}
cd "$(dirname "${BASH_SOURCE[0]}")/.."

die() { echo "release-prepare: $*" >&2; exit 2; }

# set_in FILE SED_EXPRESSION...: edit FILE, and refuse a FILE the expressions
# leave unchanged, so a version string that moved fails the bump instead of
# being skipped.
set_in() {
    local file=$1 before
    shift
    before=$(sha256sum < "${file}")
    sed -i -E "$@" "${file}"
    [ "${before}" != "$(sha256sum < "${file}")" ] || die "${file} does not name ${old} where expected"
}

[[ ${new} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "'${new}' is not X.Y.Z"
old=$(awk '/^\[package\]/{p=1; next} /^\[/{p=0} p && /^version[[:space:]]*=/{gsub(/^[^"]*"|".*$/, ""); print; exit}' Cargo.toml)
[ -n "${old}" ] || die "Cargo.toml names no [package] version"
[ "${old}" != "${new}" ] || die "Cargo.toml already names ${new}"
old_re=${old//./\\.}

if command -v towncrier > /dev/null 2>&1; then
    towncrier build --version "${new}" --yes
else
    uvx towncrier build --version "${new}" --yes
fi

set_in Cargo.toml "0,/^version = /s/^(version = )\"${old_re}\"\$/\1\"${new}\"/"
set_in Cargo.lock "/^name = \"eb-pipeline\"\$/{n;s/^(version = )\"${old_re}\"\$/\1\"${new}\"/}"
set_in share/man/eb-pipeline.1 \
    -e "s/(\"eb-pipeline )${old_re}\"/\1${new}\"/" \
    -e "s/^v${old_re}\$/v${new}/"
for page in howto/install.org reference/cli.org reference/run-summary.org tutorials/first-build-list.org; do
    set_in "docs/orgmode/${page}" \
        -e "s/^(eb-pipeline )${old_re}\$/\1${new}/" \
        -e "s/(\"tool\": \"eb-pipeline )${old_re}\"/\1${new}\"/"
done

echo "release-prepare: ${old} -> ${new}"
git status --short | awk '{print $1}' | sort | uniq -c
